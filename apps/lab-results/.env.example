# The Loops API. Use http://localhost:8787 instead when running Loops locally.
LOOPS_API_URL=https://api.ollie.health

# Both are on the lab-results loop's page in the dashboard.
LOOPS_ORGANIZATION_ID=
LOOPS_LOOP_ID=

# Create one in Settings → API tokens for the lab-results loop, with access set to "Run and read".
LOOPS_API_TOKEN=
