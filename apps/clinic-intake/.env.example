# The Loops API. Use http://localhost:8787 instead when running Loops locally.
LOOPS_API_URL=https://api.ollie.health

# Both are on the clinic-intake loop's page in the dashboard.
LOOPS_ORGANIZATION_ID=
LOOPS_LOOP_ID=

# Create one in Settings → API tokens for the clinic-intake loop, with access set to "Run and read".
LOOPS_API_TOKEN=

# Optional. A long random string for the webhook path. Set BOOKING_WEBHOOK_URL on the
# clinic-intake-record loop to https://<your app>/api/booking-requests/<this token>.
BOOKING_WEBHOOK_TOKEN=
