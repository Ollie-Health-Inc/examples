# The Loops API. Use http://localhost:8787 instead when running Loops locally.
LOOPS_API_URL=https://api.ollie.health

# On any loop's page in the dashboard.
LOOPS_ORGANIZATION_ID=

# The subscription-save agent, and the subscription-cancelled workflow (tick it when deploying).
LOOPS_AGENT_LOOP_ID=
LOOPS_CANCELLED_LOOP_ID=

# The app calls two loops, so create this in Settings → API tokens for the whole organization,
# with access set to "Run and read".
LOOPS_API_TOKEN=

# A long random string. Set SUBSCRIPTION_WEBHOOK_URL on subscription-save-outcome to
# https://<your app>/api/subscription-outcome?key=<this key>
SUBSCRIPTION_WEBHOOK_KEY=
